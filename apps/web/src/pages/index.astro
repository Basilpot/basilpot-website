---
import { SiteNavigation } from "../components/site-header"
import MorphSlider from "../components/morph-slider"
import { products } from "../data/products"
import Main from "../layouts/main.astro"

const basilSlides = [
  {
    image:
      "https://images.unsplash.com/photo-1770478518850-ba0d2fc3d947?q=85&w=2000&auto=format&fit=crop",
  },
  {
    image:
      "https://images.unsplash.com/photo-1756574747685-257ddaebe519?q=85&w=2000&auto=format&fit=crop",
  },
  {
    image:
      "https://images.unsplash.com/photo-1629157247277-48f870757026?q=85&w=2000&auto=format&fit=crop",
  },
]
---

<Main
  title="Basilpot | Web studio in Nepal"
  description="Basilpot builds in the web."
>
  <div class="home-stage">
    <div class="home-background" aria-hidden="true">
      <MorphSlider
        client:load
        items={basilSlides}
        transition="melt"
        intensity={0.55}
        aberration={0.35}
        drift={0.4}
        autoplay
        autoplayDelay={5}
        radius={0}
        overlayColor="#000000"
        showCaptions={false}
        showControls={false}
        showIndicators={false}
      />
    </div>
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main" tabindex="-1" class="home-only">
      <div class="home-flow">
        <h1>
          <span class="sr-only">Basilpot</span>
          <img src="/basilpot-logo.svg" alt="" width="473" height="96" />
        </h1>
        <nav aria-label="Products" class="home-products">
          <ul>
            {
              products.map((product) => (
                <li>
                  <a href={product.url} target="_blank" rel="noreferrer">
                    {product.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </main>
    <footer class="home-footer">
      <SiteNavigation currentPath="/" />
      <div class="footer-contact">
        <p>seed@basilpot.com</p>
        <p>Web studio, Nepal</p>
        <p>© {new Date().getFullYear()} Basilpot</p>
      </div>
    </footer>
  </div>
</Main>
