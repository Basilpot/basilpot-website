---
import { SiteFooter } from "../components/site-header"
import { products } from "../data/products"
import Main from "../layouts/main.astro"
---

<Main
  title="Basilpot | Web studio in Nepal"
  description="Basilpot builds in the web."
>
  <div class="home-stage">
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main" tabindex="-1" class="home-only">
      <div class="home-flow">
        <h1>
          <span class="sr-only">Basilpot</span>
          <img src="/basilpot-logo.svg" alt="" width="473" height="96" />
        </h1>
        <nav aria-label="Products" class="home-products">
          <ul>
            {
              products.map((product) => (
                <li>
                  <a href={product.url} target="_blank" rel="noreferrer">
                    {product.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </main>
    <SiteFooter currentPath="/" className="home-footer" />
  </div>
</Main>
