---
import { SiteHeader } from "../components/site-header"
import { products } from "../data/products"
import Main from "../layouts/main.astro"
---

<Main
  title="Basilpot | Web studio in Nepal"
  description="Basilpot builds in the web."
>
  <div class="home-stage">
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader currentPath="/" />
    <main id="main" tabindex="-1" class="home-only">
      <div class="home-flow">
        <h1 aria-label="Basilpot">BASILPOT</h1>
        <nav aria-label="Products" class="home-products">
          <ul>
            {
              products.map((product) => (
                <li>
                  <a href={product.url} target="_blank" rel="noreferrer">
                    {product.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="home-statement">
          <p>Basilpot designs and builds websites.</p>
          <p>
            We build custom business websites, travel websites and ecommerce
            stores. We also make and maintain a few web products of our own.
          </p>
        </div>
      </div>
    </main>
  </div>
</Main>
