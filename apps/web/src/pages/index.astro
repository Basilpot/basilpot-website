---
import { SiteFooter } from "../components/site-header"
import { products } from "../data/products"
import Main from "../layouts/main.astro"
---

<Main
  title="Basilpot | Global Web Design & Development Studio"
  description="Basilpot is a global web design and development studio building custom business, travel and ecommerce websites for teams worldwide."
>
  <div class="home-stage">
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main" tabindex="-1" class="home-only">
      <div class="home-flow">
        <h1>
          <span class="sr-only"
            >Basilpot global website design and development studio</span
          >
          <img src="/basilpot-logo.svg" alt="" width="473" height="96" />
        </h1>
        <nav aria-label="Products" class="home-products">
          <ul>
            {
              products.map((product) => (
                <li>
                  <a href={product.url} target="_blank" rel="noreferrer">
                    {product.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="home-intro">
          Web design and development studio for teams worldwide. We build custom
          business, travel and ecommerce websites.
        </p>
      </div>
    </main>
    <SiteFooter currentPath="/" className="home-footer" />
  </div>
</Main>
