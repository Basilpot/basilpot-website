---
import SiteShell from "../components/site-shell.astro"
import Main from "../layouts/main.astro"

const team = [
  {
    name: "Tej Kshetri",
    role: "Tech Lead",
    description:
      "Tej leads the technical direction of Basilpot and the products we build. He works across product engineering, architecture, infrastructure, and design implementation, while helping shape how ideas become reliable, useful software. He keeps our technical decisions practical, our systems maintainable, and our products focused on solving the problem rather than showing off the technology.",
  },
  {
    name: "Aashish Khadka",
    role: "Human Lead",
    description:
      "Aashish leads the people-facing side of Basilpot, from client relationships and communication to partnerships and day-to-day operations. He helps connect the people building our products with the people using them, making sure decisions aren't made inside a technical bubble. His focus is keeping our work grounded in actual people, actual businesses, and actual problems.",
  },
]
---

<Main
  title="About Basilpot | Global Web Design Studio"
  description="Meet Basilpot, a remote web design and development studio led by Tej Kshetri and Aashish Khadka, building practical custom websites worldwide."
>
  <SiteShell>
    <article>
      <h1>Global web studio</h1>
      <p>Basilpot designs and builds websites for teams worldwide.</p>
      <p>
        We build custom business websites, travel websites and ecommerce stores.
        We also make and maintain a few web products of our own. We work
        remotely across time zones, including with teams in Latin America.
      </p>
      {
        team.map((person) => (
          <section>
            <h2>{person.name}</h2>
            <p class="document-note">{person.role}</p>
            <p>{person.description}</p>
          </section>
        ))
      }
      <p>
        For project inquiries or consultation, contact <a
          href="tel:+9779841328947">+9779841328947 (Tej)</a
        > or <a href="tel:+9779805106358">+9779805106358 (Aashish)</a> or send your
        inquiries to <a href="mailto:seed@basilpot.com">seed@basilpot.com</a>.
      </p>
    </article>
  </SiteShell>
</Main>
