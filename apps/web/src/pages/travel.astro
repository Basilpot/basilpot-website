---
import SiteShell from "../components/site-shell.astro"
import Main from "../layouts/main.astro"

const sections = [
  {
    title: "Build and manage trips",
    body: "Add trip facts, pricing, inclusions, FAQs and media in the dashboard. Published websites use that structured information across trip pages and the trip catalogue.",
    image: "/travel/dashboard.png",
    alt: "Travel trip management dashboard",
    height: 953,
  },
  {
    title: "Write itineraries day by day",
    body: "Manage each day in a structured editor instead of one long text field. Days can include titles, descriptions and altitude information.",
    image: "/travel/itinerary.png",
    alt: "Travel itinerary editor",
    height: 934,
  },
  {
    title: "Organize the website",
    body: "Manage navigation, featured trips and the content people use to move around the public website without editing code.",
    image: "/travel/navigation.png",
    alt: "Travel website navigation editor",
    height: 937,
  },
  {
    title: "Publish content",
    body: "Write and publish blog posts and other useful travel content from the same system as the trip catalogue.",
    image: "/travel/content.png",
    alt: "Travel content publishing screen",
    height: 939,
  },
]

const ranges = [
  ["Small travel operators", "NPR 60,000–100,000"],
  ["Growing travel agencies", "NPR 100,000–175,000"],
  ["Established travel companies", "NPR 175,000–300,000"],
  ["Large agencies and travel brands", "From NPR 300,000"],
]
---

<Main
  title="Travel websites | Basilpot"
  description="Travel websites with a system for managing trips, itineraries, content and enquiries."
>
  <SiteShell>
    <article>
      <h1>Travel</h1>
      <p>
        We build travel websites with a system for managing trips, itineraries,
        content and enquiries. Each public website is designed around the travel
        company while sharing reliable catalogue and publishing tools
        underneath.
      </p>
      {
        sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            <p>{section.body}</p>
            <figure>
              <a
                href={section.image}
                target="_blank"
                rel="noreferrer"
                aria-label={`${section.alt} — open full-size image`}
              >
                <img
                  src={section.image}
                  alt={section.alt}
                  width="1400"
                  height={section.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                {section.alt}. Open image to view full size.
              </figcaption>
            </figure>
          </section>
        ))
      }
      <section>
        <h2>Collect enquiries</h2>
        <p>
          Each trip can have an enquiry form. Enquiries are stored in the
          dashboard with the trip and contact information needed to respond.
        </p>
      </section>
      <section>
        <h2>Structure for search</h2>
        <p>
          Trips, destinations, activities and regions create many related pages.
          We structure these relationships, URLs, metadata and internal links
          deliberately. When an existing travel website is migrated, we can plan
          redirects and preserve important URLs where appropriate.
        </p>
      </section>
      <section>
        <h2>Shared system, individual websites</h2>
        <p>
          The CMS is the underlying system. The public website is designed
          around the travel company and does not have to look like other
          websites using the same system.
        </p>
        <p><a href="/clients">View client work</a>.</p>
      </section>
      <section>
        <h2>Travel website pricing</h2>
        <p>Project ranges, not rigid packages.</p>
        <p>
          Most travel websites fall into one of these ranges. We confirm a price
          after reviewing the website, content and required system work.
        </p>
        <table>
          <caption class="sr-only">Travel website project ranges</caption>
          <thead
            ><tr
              ><th scope="col">Travel company</th><th scope="col"
                >Project range</th
              ></tr
            ></thead
          >
          <tbody>
            {
              ranges.map(([name, price]) => (
                <tr>
                  <>
                    <th scope="row">{name}</th>
                    <td>{price}</td>
                  </>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
      <section>
        <h2>What affects pricing</h2>
        <p>
          Design scope, content migration, custom functionality, multilingual
          requirements, booking systems, integrations, content entry, custom
          admin workflows and SEO migration.
        </p>
      </section>
      <section>
        <h2>Trips are managed content</h2>
        <p>
          Number of trips alone does not necessarily determine development cost
          because trips use the same CMS structure. Migrating or manually
          entering large volumes of trips is separate work and is priced by
          volume and source quality.
        </p>
      </section>
      <section>
        <h2>Starting a project</h2>
        <p>
          Send us your existing website, approximate trip count and any booking,
          payment, migration or multilingual requirements. We will reply with
          questions or a scoped range.
        </p>
        <p><a href="/contact">Discuss a travel website</a>.</p>
      </section>
    </article>
  </SiteShell>
</Main>
