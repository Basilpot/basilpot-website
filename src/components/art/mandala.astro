---
// Thangka-style mandala: ring of flames, vajra ring, lotus ring, the square palace
// with four T-shaped gates, and an eight-petal lotus at the centre.

interface Props {
  class?: string
}

const { class: className } = Astro.props

const polar = (deg: number, r: number) => {
  const a = ((deg - 90) * Math.PI) / 180
  return { x: Math.cos(a) * r, y: Math.sin(a) * r }
}

const flames = (() => {
  const n = 56
  const pts: string[] = []
  for (let i = 0; i <= n * 2; i++) {
    const r = i % 2 === 0 ? 268 : 286
    const p = polar((i * 360) / (n * 2), r)
    pts.push(`${i === 0 ? "M" : "L"} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`)
  }
  return pts.join(" ") + " Z"
})()

const ticks = Array.from({ length: 72 }, (_, i) => i * 5)
const outerPetals = Array.from({ length: 32 }, (_, i) => i * (360 / 32))
const innerPetals = Array.from({ length: 8 }, (_, i) => i * 45)

const s = 140 // palace half-size
const gate = () => (
  `M ${-38} ${-s} L ${-38} ${-s - 18} L ${-26} ${-s - 18} L ${-26} ${-s - 34} L ${26} ${-s - 34} L ${26} ${-s - 18} L ${38} ${-s - 18} L ${38} ${-s}`
)
---

<svg
  class={className}
  viewBox="-300 -300 600 600"
  role="img"
  aria-labelledby="mandala-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="mandala-title">Line drawing of a thangka mandala</title>
  <defs>
    <pattern id="md-hatch" width="4" height="4" patternUnits="userSpaceOnUse">
      <line x1="0" y1="2" x2="4" y2="2" class="ink" stroke-width="0.9"></line>
    </pattern>
  </defs>
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <circle r="292" class="ink" stroke-width="1.2"></circle>
    <path d={flames} class="ink" stroke-width="1.1"></path>
    <circle r="262" class="ink" stroke-width="1.4"></circle>
    {
      ticks.map((a) => {
        const p1 = polar(a, 244)
        const p2 = polar(a, 258)
        return <line x1={p1.x} y1={p1.y} x2={p2.x} y2={p2.y} class="ink" stroke-width="1.6" />
      })
    }
    <circle r="240" class="ink" stroke-width="1.2"></circle>
    {
      outerPetals.map((a) => (
        <path
          transform={`rotate(${a})`}
          d="M -16 -204 Q -16 -232 0 -238 Q 16 -232 16 -204"
          class="ink"
          stroke-width="1.1"
        />
      ))
    }
    <circle r="204" class="ink" stroke-width="1.4"></circle>
    <circle r="196" fill="url(#md-hatch)"></circle>

    <!-- palace -->
    {
      [0, 90, 180, 270].map((r) => (
        <path transform={`rotate(${r})`} d={gate()} class="paper ink" stroke-width="1.4" />
      ))
    }
    <rect x={-s} y={-s} width={s * 2} height={s * 2} class="paper ink" stroke-width="1.6"></rect>
    <rect x={-s + 10} y={-s + 10} width={(s - 10) * 2} height={(s - 10) * 2} class="ink" stroke-width="1"></rect>
    <rect x={-s + 20} y={-s + 20} width={(s - 20) * 2} height={(s - 20) * 2} fill="url(#md-hatch)" class="ink" stroke-width="1"></rect>
    <rect x={-s + 30} y={-s + 30} width={(s - 30) * 2} height={(s - 30) * 2} class="paper ink" stroke-width="1.2"></rect>

    <!-- inner lotus -->
    <circle r="104" class="ink" stroke-width="1.3"></circle>
    {
      innerPetals.map((a) => (
        <g transform={`rotate(${a})`}>
          <path d="M 0 -30 C 22 -50 22 -80 0 -100 C -22 -80 -22 -50 0 -30 Z" class="paper ink" stroke-width="1.3" />
          <path d="M 0 -40 C 10 -54 10 -76 0 -88" class="ink" stroke-width="0.8" />
        </g>
      ))
    }
    {
      innerPetals.map((a) => (
        <path
          transform={`rotate(${a + 22.5})`}
          d="M 0 -34 C 10 -46 10 -62 0 -72 C -10 -62 -10 -46 0 -34 Z"
          class="ink"
          stroke-width="1"
        />
      ))
    }
    <circle r="30" class="paper ink" stroke-width="1.4"></circle>
    <circle r="18" class="ink" stroke-width="1"></circle>
    <circle r="6" class="inkfill"></circle>
  </g>
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .ink {
    stroke: var(--ink);
  }
  .inkfill {
    fill: var(--ink);
  }
  .paper {
    fill: var(--paper);
  }
</style>
