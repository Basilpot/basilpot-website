---
// Engraving of the Annapurna range above Pokhara: a fishtail peak, the far range,
// terraced hillsides in the foreground and a string of prayer flags.

interface Props {
  class?: string
}

const { class: className } = Astro.props

const W = 1000
const H = 460

let seed = 41
const rand = () => {
  seed = (seed * 16807) % 2147483647
  return (seed - 1) / 2147483646
}

// Far range: jagged line across the width
const far = (() => {
  const pts: [number, number][] = [[0, 250]]
  let x = 0
  while (x < W) {
    x += 14 + rand() * 30
    const near = Math.abs(x - 220) < 120 || Math.abs(x - 800) < 140
    pts.push([x, near ? 150 + rand() * 50 : 210 + rand() * 40])
  }
  return pts
})()
const farLine = far.map(([x, y], i) => `${i ? "L" : "M"} ${x.toFixed(1)} ${y.toFixed(1)}`).join(" ")
const farFill = `${farLine} L ${W} ${H} L 0 ${H} Z`

// Fishtail peak (lit left face, hatched right face)
const peak = {
  outline: "M 340 330 L 420 230 L 455 170 L 478 110 L 492 62 L 500 88 L 512 54 L 524 104 L 548 160 L 590 220 L 680 330 Z",
  shade: "M 512 54 L 524 104 L 548 160 L 590 220 L 680 330 L 520 330 L 506 200 L 500 88 Z",
  snow: [
    "M 492 62 L 486 98 L 474 130",
    "M 500 88 L 497 130 L 490 168",
    "M 478 110 L 462 150",
    "M 455 170 L 440 205",
  ],
}

// Foreground hills with terraces
const hills = [
  { d: "M -10 360 Q 160 300 330 350 Q 420 378 470 470 L -10 470 Z", cx: 160, cy: 520 },
  { d: "M 520 470 Q 600 360 760 340 Q 900 326 1010 372 L 1010 470 Z", cx: 780, cy: 560 },
]
const terraceRings = Array.from({ length: 22 }, (_, i) => 60 + i * 11)

// Prayer flags across the upper left
const flagLine = { a: { x: 40, y: 70 }, c: { x: 200, y: 150 }, b: { x: 380, y: 96 } }
const flags = Array.from({ length: 15 }, (_, i) => {
  const t = (i + 1) / 16
  const { a, b, c } = flagLine
  const x = (1 - t) ** 2 * a.x + 2 * (1 - t) * t * c.x + t ** 2 * b.x
  const y = (1 - t) ** 2 * a.y + 2 * (1 - t) * t * c.y + t ** 2 * b.y
  return { x, y, kind: i % 5 }
})

const birds = [
  [640, 110],
  [662, 98],
  [690, 120],
  [612, 128],
]
---

<svg
  class={className}
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-labelledby="himalaya-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="himalaya-title">
    Engraving of a fishtail Himalayan peak above terraced hills, with prayer
    flags
  </title>
  <defs>
    <pattern id="hm-hatch" width="4" height="4" patternUnits="userSpaceOnUse">
      <line x1="0" y1="2" x2="4" y2="2" class="ink" stroke-width="1"></line>
    </pattern>
    <pattern id="hm-dots" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="2.5" cy="2.5" r="0.8" class="inkfill"></circle>
    </pattern>
    {
      hills.map((h, i) => (
        <clipPath id={`hm-hill-${i}`}>
          <path d={h.d} />
        </clipPath>
      ))
    }
  </defs>

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- sun -->
    <circle cx="820" cy="96" r="44" class="ink" stroke-width="1.3"></circle>
    <circle cx="820" cy="96" r="36" fill="url(#hm-dots)"></circle>

    <!-- far range -->
    <path d={farFill} class="paper"></path>
    <path d={farLine} class="ink" stroke-width="1.1"></path>
    <path d={farFill} fill="url(#hm-dots)" opacity="0.5"></path>

    <!-- fishtail -->
    <path d={peak.outline} class="paper ink" stroke-width="1.5"></path>
    <path d={peak.shade} fill="url(#hm-hatch)"></path>
    {peak.snow.map((d) => <path d={d} class="ink" stroke-width="1" />)}

    <!-- mid ridge -->
    <path
      d="M 0 330 Q 120 300 250 322 T 520 316 T 780 300 T 1000 318 L 1000 470 L 0 470 Z"
      class="paper ink"
      stroke-width="1.3"></path>

    <!-- terraced hills -->
    {
      hills.map((h, i) => (
        <g>
          <path d={h.d} class="paper ink" stroke-width="1.4" />
          <g clip-path={`url(#hm-hill-${i})`}>
            {terraceRings.map((r, k) => (
              <ellipse
                cx={h.cx}
                cy={h.cy}
                rx={r * 1.9}
                ry={r * 0.95}
                class="ink"
                stroke-width={k % 3 === 0 ? 1.1 : 0.7}
              />
            ))}
          </g>
        </g>
      ))
    }

    <!-- flags -->
    <path
      d={`M ${flagLine.a.x} ${flagLine.a.y} Q ${flagLine.c.x} ${flagLine.c.y} ${flagLine.b.x} ${flagLine.b.y}`}
      class="ink"
      stroke-width="1"></path>
    <line x1={flagLine.a.x} y1={flagLine.a.y} x2={flagLine.a.x} y2="372" class="ink" stroke-width="1.4"></line>
    {
      flags.map((f) => (
        <rect
          x={f.x - 7}
          y={f.y}
          width="14"
          height="18"
          class={f.kind === 0 ? "inkfill" : f.kind === 2 ? "ink" : "paper ink"}
          fill={f.kind === 2 ? "url(#hm-hatch)" : undefined}
          stroke-width="0.9"
        />
      ))
    }

    <!-- birds -->
    {
      birds.map(([x, y]) => (
        <path d={`M ${x - 7} ${y} q 4 -5 7 0 q 3 -5 7 0`} class="ink" stroke-width="1.1" />
      ))
    }

    <line x1="0" y1={H - 1} x2={W} y2={H - 1} class="ink" stroke-width="1.4"></line>
  </g>
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .ink {
    stroke: var(--ink);
  }
  .inkfill {
    fill: var(--ink);
  }
  .paper {
    fill: var(--paper);
  }
</style>
