---
// Engraving of a Himalayan singing bowl on its ring cushion, with the striker
// and the sound rings it sends out.

interface Props {
  class?: string
}

const { class: className } = Astro.props

const W = 760
const H = 440
const cx = 380
const rimY = 230
const rimRx = 170
const rimRy = 38
const baseY = 360

const bowl = `M ${cx - rimRx} ${rimY} C ${cx - rimRx + 4} ${rimY + 90} ${cx - 90} ${baseY} ${cx} ${baseY} C ${cx + 90} ${baseY} ${cx + rimRx - 4} ${rimY + 90} ${cx + rimRx} ${rimY} A ${rimRx} ${rimRy} 0 0 1 ${cx - rimRx} ${rimY} Z`

const rings = Array.from({ length: 6 }, (_, i) => ({
  rx: rimRx + 50 + i * 44,
  ry: rimRy + 14 + i * 12,
  o: 1 - i * 0.14,
}))

// Engraved band of small lotus marks under the rim
const band = Array.from({ length: 15 }, (_, i) => {
  const t = (i + 0.5) / 15
  const a = Math.PI * t
  return { x: cx - Math.cos(a) * (rimRx - 12), y: rimY + 26 + Math.sin(a) * 18 }
})
---

<svg
  class={className}
  viewBox={`0 104 ${W} ${H - 104}`}
  role="img"
  aria-labelledby="bowl-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="bowl-title">
    Engraving of a singing bowl on a cushion with its striker and sound rings
  </title>
  <defs>
    <pattern id="sb-hatch" width="3.6" height="3.6" patternUnits="userSpaceOnUse">
      <line x1="0" y1="1.8" x2="3.6" y2="1.8" class="ink" stroke-width="0.9"></line>
    </pattern>
    <pattern id="sb-dots" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="2.5" cy="2.5" r="0.85" class="inkfill"></circle>
    </pattern>
    <clipPath id="sb-bowl">
      <path d={bowl}></path>
    </clipPath>
  </defs>

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- sound rings -->
    {
      rings.map((r) => (
        <ellipse
          cx={cx}
          cy={rimY + 10}
          rx={r.rx}
          ry={r.ry}
          class="ink"
          stroke-width="1"
          stroke-dasharray="2 7"
          opacity={r.o}
        />
      ))
    }

    <!-- cushion -->
    <ellipse cx={cx} cy={baseY + 22} rx="150" ry="34" class="paper ink" stroke-width="1.4"></ellipse>
    <ellipse cx={cx} cy={baseY + 22} rx="150" ry="34" fill="url(#sb-dots)"></ellipse>
    <ellipse cx={cx} cy={baseY + 8} rx="104" ry="20" class="paper ink" stroke-width="1.2"></ellipse>
    {
      Array.from({ length: 18 }, (_, i) => {
        const a = (i / 18) * Math.PI * 2
        const x1 = cx + Math.cos(a) * 112
        const y1 = baseY + 22 + Math.sin(a) * 25
        const x2 = cx + Math.cos(a) * 142
        const y2 = baseY + 22 + Math.sin(a) * 32
        return <line x1={x1} y1={y1} x2={x2} y2={y2} class="ink" stroke-width="0.8" />
      })
    }

    <!-- bowl -->
    <path d={bowl} class="paper ink" stroke-width="1.6"></path>
    <g clip-path="url(#sb-bowl)">
      <rect x={cx + 40} y={rimY} width={rimRx} height={baseY - rimY + 2} fill="url(#sb-hatch)"></rect>
      <path
        d={`M ${cx - rimRx + 6} ${rimY + 46} Q ${cx} ${rimY + 96} ${cx + rimRx - 6} ${rimY + 46}`}
        class="ink"
        stroke-width="1"></path>
      <path
        d={`M ${cx - rimRx + 10} ${rimY + 56} Q ${cx} ${rimY + 106} ${cx + rimRx - 10} ${rimY + 56}`}
        class="ink"
        stroke-width="0.7"></path>
    </g>
    {
      band.map((b) => (
        <path
          d={`M ${b.x} ${b.y + 6} C ${b.x - 5} ${b.y} ${b.x - 2} ${b.y - 6} ${b.x} ${b.y - 8} C ${b.x + 2} ${b.y - 6} ${b.x + 5} ${b.y} ${b.x} ${b.y + 6} Z`}
          class="ink"
          stroke-width="0.8"
        />
      ))
    }

    <!-- rim and inside -->
    <ellipse cx={cx} cy={rimY} rx={rimRx} ry={rimRy} class="paper ink" stroke-width="1.6"></ellipse>
    <ellipse cx={cx} cy={rimY + 3} rx={rimRx - 12} ry={rimRy - 8} class="ink" stroke-width="0.9"></ellipse>
    <path
      d={`M ${cx - rimRx + 14} ${rimY + 4} A ${rimRx - 14} ${rimRy - 10} 0 0 0 ${cx + rimRx - 14} ${rimY + 4}`}
      fill="url(#sb-hatch)"></path>

    <!-- striker -->
    <g transform={`rotate(-24 ${cx + 250} ${baseY + 10})`}>
      <rect x={cx + 120} y={baseY - 4} width="230" height="22" rx="11" class="paper ink" stroke-width="1.4"></rect>
      <rect x={cx + 120} y={baseY - 4} width="70" height="22" rx="11" fill="url(#sb-dots)" class="ink" stroke-width="1.2"></rect>
      <line x1={cx + 200} y1={baseY + 7} x2={cx + 344} y2={baseY + 7} class="ink" stroke-width="0.7"></line>
    </g>

    <line x1="20" y1={H - 8} x2={W - 20} y2={H - 8} class="ink" stroke-width="1.4"></line>
  </g>
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .ink {
    stroke: var(--ink);
  }
  .inkfill {
    fill: var(--ink);
  }
  .paper {
    fill: var(--paper);
  }
</style>
