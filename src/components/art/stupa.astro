---
// Engraving of a Kathmandu Valley stupa (after Boudhanath): dome, harmika with the
// watching eyes, thirteen-step spire, and prayer flags strung to the ground.
// Colours come from --ink (lines) and --paper (fills), so it works on any panel.

interface Props {
  class?: string
}

const { class: className } = Astro.props

const W = 1400
const H = 620
const cx = W / 2
const ground = 600

let seed = 23
const rand = () => {
  seed = (seed * 16807) % 2147483647
  return (seed - 1) / 2147483646
}

// Terraces
const terraces = [
  { w: 980, h: 20 },
  { w: 860, h: 20 },
  { w: 740, h: 20 },
].map((t, i) => ({ ...t, y: ground - 20 * (i + 1), x: cx - t.w / 2 }))
const domeBase = ground - 60

// Dome
const domeRx = 268
const domeRy = 176
const domeTop = domeBase - domeRy

// Harmika
const hW = 136
const hH = 92
const hTop = domeTop - 12 - hH

// Spire: thirteen rings
const spireBase = hTop - 10
const rings = Array.from({ length: 13 }, (_, i) => {
  const w = 112 - i * 5.6
  const h = 9
  return { x: cx - w / 2, y: spireBase - (i + 1) * (h + 1.4), w, h }
})
const spireTop = rings[rings.length - 1].y
const canopyTop = spireTop - 26
const finialTop = canopyTop - 46

// Prayer-flag strings, anchored at the canopy and falling to the ground.
const anchor = { x: cx, y: canopyTop + 6 }
const ends = [70, 210, 360, 500]
type Flag = { x: number; y: number; a: number; kind: number }
const strings = [-1, 1].flatMap((side) =>
  ends.map((e, k) => {
    const end = { x: cx + side * (cx - e), y: ground - 4 }
    const ctrl = {
      x: anchor.x + (end.x - anchor.x) * 0.55,
      y: anchor.y + (end.y - anchor.y) * 0.62 + 40 + k * 8,
    }
    const flags: Flag[] = []
    const n = 18 + k * 2
    for (let i = 2; i < n - 1; i++) {
      const t = i / n
      const x =
        (1 - t) ** 2 * anchor.x + 2 * (1 - t) * t * ctrl.x + t ** 2 * end.x
      const y =
        (1 - t) ** 2 * anchor.y + 2 * (1 - t) * t * ctrl.y + t ** 2 * end.y
      const dx = 2 * (1 - t) * (ctrl.x - anchor.x) + 2 * t * (end.x - ctrl.x)
      const dy = 2 * (1 - t) * (ctrl.y - anchor.y) + 2 * t * (end.y - ctrl.y)
      const a = (Math.atan2(dy, dx) * 180) / Math.PI
      flags.push({ x, y, a: side > 0 ? a : a + 180, kind: i % 5 })
    }
    return {
      d: `M ${anchor.x} ${anchor.y} Q ${ctrl.x} ${ctrl.y} ${end.x} ${end.y}`,
      flags,
    }
  })
)

// Himalayan ridge on the horizon
const ridge = (() => {
  const pts: string[] = []
  let x = 0
  let y = 330
  pts.push(`M 0 ${y}`)
  while (x < W) {
    x += 18 + rand() * 40
    const peak = Math.abs(x - 300) < 140 || Math.abs(x - 1110) < 160
    y = peak ? 230 + rand() * 70 : 300 + rand() * 50
    pts.push(`L ${x.toFixed(1)} ${y.toFixed(1)}`)
  }
  return pts.join(" ")
})()

// Prayer wheels / niches around the dome base
const niches = Array.from({ length: 21 }, (_, i) => {
  const t = (i + 0.5) / 21
  return cx - 360 + 720 * t
})

// Eyes
const eyes = [-1, 1].map((s) => ({ x: cx + s * 30, y: hTop + 44 }))
---

<svg
  class={className}
  viewBox={`0 ${finialTop - 20} ${W} ${H - finialTop + 20}`}
  role="img"
  aria-labelledby="stupa-title"
  xmlns="http://www.w3.org/2000/svg"
  preserveAspectRatio="xMidYMax meet"
>
  <title id="stupa-title">
    Engraving of a Himalayan stupa with painted eyes and prayer flags
  </title>
  <defs>
    <pattern id="st-hatch" width="4" height="4" patternUnits="userSpaceOnUse">
      <line x1="0" y1="2" x2="4" y2="2" class="ink" stroke-width="1"></line>
    </pattern>
    <pattern id="st-dots" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="2.5" cy="2.5" r="0.9" class="inkfill"></circle>
    </pattern>
    <clipPath id="st-dome-shade">
      <rect x={cx + 90} y={domeTop} width={domeRx} height={domeRy}></rect>
    </clipPath>
  </defs>

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d={ridge} class="ink faint" stroke-width="1.2"></path>

    {
      strings.map((s) => (
        <g>
          <path d={s.d} class="ink" stroke-width="1" />
          {s.flags.map((f) => (
            <g transform={`translate(${f.x} ${f.y}) rotate(${f.a})`}>
              <rect
                x="-7"
                y="0"
                width="14"
                height="17"
                class={
                  f.kind === 0
                    ? "inkfill"
                    : f.kind === 2 || f.kind === 4
                      ? "ink"
                      : "paper ink"
                }
                fill={f.kind === 2 ? "url(#st-hatch)" : f.kind === 4 ? "url(#st-dots)" : undefined}
                stroke-width="0.9"
              />
            </g>
          ))}
        </g>
      ))
    }

    <!-- terraces -->
    {
      terraces.map((t) => (
        <g>
          <rect x={t.x} y={t.y} width={t.w} height={t.h} class="paper ink" stroke-width="1.3" />
          <rect x={t.x + t.w * 0.72} y={t.y} width={t.w * 0.28} height={t.h} fill="url(#st-hatch)" />
        </g>
      ))
    }

    <!-- dome -->
    <path
      d={`M ${cx - domeRx} ${domeBase} A ${domeRx} ${domeRy} 0 0 1 ${cx + domeRx} ${domeBase} Z`}
      class="paper ink"
      stroke-width="1.6"></path>
    <path
      d={`M ${cx - domeRx} ${domeBase} A ${domeRx} ${domeRy} 0 0 1 ${cx + domeRx} ${domeBase} Z`}
      fill="url(#st-dots)"
      clip-path="url(#st-dome-shade)"></path>
    <!-- whitewash drips: the saffron arcs thrown over the dome -->
    {
      Array.from({ length: 9 }, (_, i) => {
        const a0 = Math.PI * (0.12 + i * 0.095)
        const x = cx - Math.cos(a0) * domeRx
        const y = domeBase - Math.sin(a0) * domeRy
        return (
          <path
            d={`M ${x} ${y} q 8 ${30 + (i % 3) * 14} -2 ${60 + (i % 2) * 20}`}
            class="ink faint"
            stroke-width="1"
          />
        )
      })
    }
    {
      niches.map((x) => (
        <g>
          <rect x={x - 6} y={domeBase - 16} width="12" height="16" class="paper ink" stroke-width="0.9" />
          <line x1={x} y1={domeBase - 13} x2={x} y2={domeBase - 3} class="ink" stroke-width="0.8" />
        </g>
      ))
    }

    <!-- dome collar -->
    <rect x={cx - 80} y={domeTop - 12} width="160" height="14" class="paper ink" stroke-width="1.3"></rect>

    <!-- harmika -->
    <rect x={cx - hW / 2} y={hTop} width={hW} height={hH} class="paper ink" stroke-width="1.5"></rect>
    <rect x={cx - hW / 2 + 6} y={hTop + 6} width={hW - 12} height={hH - 12} class="ink" stroke-width="0.8"></rect>
    {
      eyes.map((e, i) => (
        <g>
          <path
            d={`M ${e.x - 22} ${e.y} Q ${e.x} ${e.y - 15} ${e.x + 22} ${e.y} Q ${e.x} ${e.y + 9} ${e.x - 22} ${e.y} Z`}
            class="paper ink"
            stroke-width="1.6"
          />
          <path
            d={`M ${e.x - 7} ${e.y - 5} A 7 7 0 0 0 ${e.x + 7} ${e.y - 5} L ${e.x + 7} ${e.y - 8} L ${e.x - 7} ${e.y - 8} Z`}
            class="inkfill"
          />
          <path
            d={`M ${e.x - 24} ${e.y - 16} Q ${e.x} ${e.y - 28} ${e.x + 24} ${e.y - 16 + (i ? 2 : -2)}`}
            class="ink"
            stroke-width="1.6"
          />
        </g>
      ))
    }
    <!-- urna and the nose drawn as the Nepali numeral one -->
    <circle cx={cx} cy={hTop + 18} r="2.6" class="inkfill"></circle>
    <path
      d={`M ${cx - 6} ${hTop + 52} C ${cx + 4} ${hTop + 46} ${cx + 10} ${hTop + 56} ${cx + 2} ${hTop + 62} C ${cx - 6} ${hTop + 68} ${cx - 2} ${hTop + 76} ${cx + 6} ${hTop + 80}`}
      class="ink"
      stroke-width="2"></path>

    <!-- spire -->
    <rect x={cx - 64} y={spireBase} width="128" height="10" class="paper ink" stroke-width="1.3"></rect>
    {
      rings.map((r) => (
        <g>
          <rect x={r.x} y={r.y} width={r.w} height={r.h} class="paper ink" stroke-width="1.1" />
          <rect x={r.x + r.w * 0.7} y={r.y} width={r.w * 0.3} height={r.h} fill="url(#st-hatch)" />
        </g>
      ))
    }

    <!-- canopy and finial -->
    <path
      d={`M ${cx - 46} ${spireTop} Q ${cx - 30} ${spireTop - 6} ${cx - 14} ${canopyTop} L ${cx + 14} ${canopyTop} Q ${cx + 30} ${spireTop - 6} ${cx + 46} ${spireTop} Z`}
      class="paper ink"
      stroke-width="1.3"></path>
    {
      Array.from({ length: 13 }, (_, i) => {
        const x = cx - 44 + i * 7.33
        return <line x1={x} y1={spireTop + 1} x2={x} y2={spireTop + 8} class="ink" stroke-width="0.8" />
      })
    }
    <ellipse cx={cx} cy={canopyTop - 8} rx="10" ry="8" class="paper ink" stroke-width="1.2"></ellipse>
    <ellipse cx={cx} cy={canopyTop - 20} rx="6" ry="5" class="paper ink" stroke-width="1.1"></ellipse>
    <path
      d={`M ${cx - 4} ${canopyTop - 24} C ${cx - 4} ${canopyTop - 34} ${cx} ${canopyTop - 40} ${cx} ${finialTop} C ${cx} ${canopyTop - 40} ${cx + 4} ${canopyTop - 34} ${cx + 4} ${canopyTop - 24} Z`}
      class="paper ink"
      stroke-width="1.1"></path>

    <line x1="0" y1={ground} x2={W} y2={ground} class="ink" stroke-width="1.4"></line>
  </g>
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .ink {
    stroke: var(--ink);
  }
  .inkfill {
    fill: var(--ink);
  }
  .paper {
    fill: var(--paper);
  }
  .faint {
    opacity: 0.55;
  }
</style>
