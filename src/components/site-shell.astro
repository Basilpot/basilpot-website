---
import LineSidebar from "./line-sidebar"

const pathname = Astro.url.pathname
const toc =
  {
    "/about": [
      "Remote web studio",
      "Tej Kshetri",
      "Aashish Khadka",
    ],
    "/contact": ["Contact"],
    "/ecommerce": [
      "Ecommerce websites",
      "Products and collections",
      "Store content",
      "Storefront design",
      "Ash & Moss",
    ],
    "/media-and-marketing": ["Media and marketing"],
    "/services": [
      "Design and development",
      "Remote teams, international reach",
      "Business websites",
      "Travel websites",
      "Ecommerce websites",
      "Website migration",
      "Maintenance",
      "Media and marketing",
      "Start a project",
    ],
    "/travel": [
      "Travel websites",
      "Build and manage trips",
      "Write itineraries day by day",
      "Organize the website",
      "Publish content",
      "Collect enquiries",
      "Structure for search",
      "Shared system, individual websites",
      "Travel website pricing",
      "What affects pricing",
      "Trips are managed content",
      "Starting a project",
    ],
  }[pathname.replace(/\/$/, "")] ?? []
---

<div class="np-doc-wrap">
  {
    toc.length > 0 && (
      <LineSidebar
        client:load
        items={toc}
        accentColor="#dc143c"
        textColor="rgb(220 20 60 / 0.55)"
        markerColor="rgb(220 20 60 / 0.3)"
        fontSize={0.7}
        markerLength={32}
        maxShift={12}
        itemGap={12}
      />
    )
  }
  <div class="np-doc">
    <slot />
  </div>
</div>
